@code {
    // ── Constants ───────────────────────────────────────────
    private const double NodeW = 155;
    private const double NodeH = 95;
    private const double CanvasW = 1600;
    private const double CanvasH = 900;

    // ── State ───────────────────────────────────────────────
    private ServiceProject? ActiveProject;
    private bool ShowAllNodes = false;
    private ServiceNode? SelectedNode;
    private ServiceConnection? SelectedConnection;
    private string SearchQuery = "";
    private HashSet<string> StatusFilter = new() { "Active", "Down" };
    private HashSet<string> TechFilter = new() { "REST", "SOAP", "JAR", "gRPC", "MQ", "Anasistem", "UI" };
    private bool ShowProjectDropdown = false;
    private bool IsDark = false;
    private bool CheckingHealth = false;
    private bool ShowGuide = false;

    // ── Dialog state ────────────────────────────────────────
    private bool ShowNodeDialog;
    private bool ShowConnectionDialog;
    private bool ShowProjectDialog;
    private bool ShowDeleteConfirm;
    private ServiceNode? EditingNode;
    private ServiceProject? EditingProject;
    private ServiceNode? NodeToDelete;

    // ── Form models ─────────────────────────────────────────
    private NodeFormModel NodeForm = new();
    private ConnectionFormModel ConnForm = new();
    private ProjectFormModel ProjForm = new();

    // ── JS references ────────────────────────────────────────
    private DotNetObjectReference<Home>? _dotNetRef;

    // ── Computed ────────────────────────────────────────────
    private List<ServiceNode> VisibleNodes
    {
        get
        {
            var nodes = ActiveProject is not null
                ? TreeService.GetNodesForProject(ActiveProject.Id)
                : TreeService.Nodes;

            if (!string.IsNullOrWhiteSpace(SearchQuery))
                nodes = nodes.Where(n =>
                    n.Name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                    n.Owner.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                    n.Team.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)
                ).ToList();

            return nodes
                .Where(n => StatusFilter.Contains(n.Status))
                .Where(n => string.IsNullOrEmpty(n.Technology) || TechFilter.Contains(n.Technology))
                .ToList();
        }
    }

    private List<ServiceConnection> VisibleConnections
    {
        get
        {
            var nodeIds = VisibleNodes.Select(n => n.Id).ToHashSet();
            return TreeService.Connections
                .Where(c => nodeIds.Contains(c.SourceId) && nodeIds.Contains(c.TargetId))
                .ToList();
        }
    }

    private List<ServiceNode> ConnectionCandidateNodes =>
        (ShowAllNodes || ActiveProject is not null ? VisibleNodes : TreeService.Nodes)
        .Where(n => TreeService.GetNode(n.Id) is not null)
        .OrderBy(n => n.Name)
        .ToList();

    private List<ServiceNode> ConnectionTargetCandidateNodes
    {
        get
        {
            var nodes = ConnectionCandidateNodes;
            if (Guid.TryParse(ConnForm.SourceIdStr, out var src))
                nodes = nodes.Where(n => n.Id != src).ToList();
            return nodes;
        }
    }

    private List<ServiceProject> FilteredProjects
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchQuery)) return TreeService.Projects;
            return TreeService.Projects
                .Where(p => p.Name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    // ── Lifecycle ────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        TreeService.OnChange += OnTreeServiceChanged;
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    private void OnTreeServiceChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            IsDark = await JS.InvokeAsync<bool>("ServiceMap.loadTheme");
            await JS.InvokeVoidAsync("ServiceMap.initDrag", _dotNetRef);
            StateHasChanged();
        }

        // Init drag on each visible node (only when canvas is in DOM)
        if (ShowAllNodes || ActiveProject is not null)
        {
            foreach (var node in VisibleNodes)
            {
                var id = node.Id.ToString();
                await JS.InvokeVoidAsync("eval",
                    $@"(function(){{
                        var el = document.getElementById('node-{id}');
                        var canvas = document.getElementById('st-canvas');
                        if(el && canvas && !el.__dragInit) {{
                            el.__dragInit = true;
                            ServiceMap.enableNodeDrag('{id}', el, canvas);
                        }}
                    }})()");
            }

            // Init zoom/pan once
            await JS.InvokeVoidAsync("eval",
                @"(function(){
                    var c = document.getElementById('st-canvas');
                    if(c && !c.__zoomInit){ c.__zoomInit=true; ServiceMap.initZoomPan(c); }
                })()");

            // Update minimap
            await UpdateMinimapAsync();
        }
        else
        {
            await ClearMinimapAsync();
        }
    }

    public void Dispose()
    {
        TreeService.OnChange -= OnTreeServiceChanged;
        _dotNetRef?.Dispose();
        _positionDebounce?.Dispose();
    }

    // ── JS Invokable: drag callbacks ─────────────────────────
    // IMPORTANT: JSInterop invokeMethodAsync requires Task (not void).
    // A void return causes the circuit to fault when JS awaits the promise.

    private System.Threading.Timer? _positionDebounce;
    private DateTime _lastDragRender = DateTime.MinValue;

    [JSInvokable]
    public Task OnNodeDragging(string nodeIdStr, double x, double y)
    {
        // Live-update the in-memory position so SVG connections redraw smoothly,
        // but do NOT persist to DB on every mousemove — only on drop.
        if (Guid.TryParse(nodeIdStr, out var id))
        {
            var node = TreeService.GetNode(id);
            if (node is not null)
            {
                node.PositionX = Clamp(x, 0, CanvasW - NodeW);
                node.PositionY = Clamp(y, 0, CanvasH - NodeH);
                // Throttle render during drag to prevent Blazor/DOM flicker.
                if ((DateTime.UtcNow - _lastDragRender).TotalMilliseconds > 80)
                {
                    _lastDragRender = DateTime.UtcNow;
                    InvokeAsync(StateHasChanged);
                }
            }
        }
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnNodeDropped(string nodeIdStr, double x, double y)
    {
        try
        {
            if (!Guid.TryParse(nodeIdStr, out var id))
                return Task.CompletedTask;

            var node = TreeService.GetNode(id);
            if (node is null)
                return Task.CompletedTask;

            double safeX = Clamp(double.IsNaN(x) || double.IsInfinity(x) ? node.PositionX : x, 0, CanvasW - NodeW);
            double safeY = Clamp(double.IsNaN(y) || double.IsInfinity(y) ? node.PositionY : y, 0, CanvasH - NodeH);
            node.PositionX = safeX;
            node.PositionY = safeY;

            // Debounce: cancel any pending save and schedule a new one 400 ms after drop
            _positionDebounce?.Dispose();
            _positionDebounce = new System.Threading.Timer(_ =>
            {
                InvokeAsync(() => TreeService.UpdateNodePositionAsync(id, safeX, safeY));
            }, null, 400, System.Threading.Timeout.Infinite);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[OnNodeDropped] {ex.Message}");
        }
        return Task.CompletedTask;
    }

    // ── Zoom / Pan ───────────────────────────────────────────
    private async Task ZoomIn()
    {
        await JS.InvokeVoidAsync("eval",
            "(function(){ var c=document.getElementById('st-canvas'); if(c) ServiceMap.zoomIn(c); })()");
    }
    private async Task ZoomOut()
    {
        await JS.InvokeVoidAsync("eval",
            "(function(){ var c=document.getElementById('st-canvas'); if(c) ServiceMap.zoomOut(c); })()");
    }
    private async Task ResetZoom()
    {
        await JS.InvokeVoidAsync("eval",
            "(function(){ var c=document.getElementById('st-canvas'); if(c) ServiceMap.resetZoom(c); })()");
    }

    // ── Theme ────────────────────────────────────────────────
    private async Task ToggleTheme()
    {
        IsDark = !IsDark;
        await JS.InvokeVoidAsync("ServiceMap.applyTheme", IsDark);
    }

    // ── Export ───────────────────────────────────────────────
    private async Task ExportSVG() => await JS.InvokeVoidAsync("ServiceMap.exportSVG");
    private async Task ExportPNG() => await JS.InvokeVoidAsync("ServiceMap.exportPNG");

    // ── Auto Layout ──────────────────────────────────────────
    private void RunAutoLayout()
    {
        TreeService.AutoLayout();
    }

    // ── Health Check ─────────────────────────────────────────
    private async Task RunHealthCheck()
    {
        if (CheckingHealth) return;
        CheckingHealth = true;
        StateHasChanged();
        try
        {
            await HealthChecker.CheckAllNowAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[HealthCheck] {ex.Message}");
        }
        finally
        {
            CheckingHealth = false;
            StateHasChanged();
        }
    }

    // ── Minimap ──────────────────────────────────────────────
    private async Task UpdateMinimapAsync()
    {
        var nodeData = VisibleNodes.Select(n => new
        {
            positionX = n.PositionX,
            positionY = n.PositionY,
            status = n.Status
        }).ToList();

        await JS.InvokeVoidAsync("eval",
            $@"(function(){{
                var c = document.getElementById('minimap-canvas');
                if(c) ServiceMap.updateMinimap(c, {System.Text.Json.JsonSerializer.Serialize(nodeData)});
            }})()");
    }

    private async Task ClearMinimapAsync()
    {
        await JS.InvokeVoidAsync("eval",
            "(function(){ var c=document.getElementById('minimap-canvas'); if(c) ServiceMap.updateMinimap(c, []); })()");
    }

    // ── Navigation ───────────────────────────────────────────
    private void GoHome() { ActiveProject = null; ShowAllNodes = false; DeselectAll(); _ = ClearMinimapAsync(); }
    private void ShowAll() { ActiveProject = null; ShowAllNodes = true; DeselectAll(); _ = UpdateMinimapAsync(); }
    private void SelectProject(ServiceProject p) { ActiveProject = p; ShowAllNodes = true; DeselectAll(); _ = UpdateMinimapAsync(); }
    private void SelectNode(ServiceNode n) { SelectedNode = n; SelectedConnection = null; }
    private void SelectConnection(ServiceConnection c) { SelectedConnection = c; SelectedNode = null; }
    private void DeselectAll() { SelectedNode = null; SelectedConnection = null; }

    private bool IsRelated(ServiceNode node) =>
        SelectedNode is not null && TreeService.Connections.Any(c =>
            (c.SourceId == SelectedNode.Id && c.TargetId == node.Id) ||
            (c.TargetId == SelectedNode.Id && c.SourceId == node.Id));

    // ── Filter toggles ───────────────────────────────────────
    private void ToggleStatusFilter(string s, bool on) { if (on) StatusFilter.Add(s); else StatusFilter.Remove(s); }
    private void ToggleTechFilter(string t, bool on) { if (on) TechFilter.Add(t); else TechFilter.Remove(t); }

    // ── Node dialog ──────────────────────────────────────────
    private void OpenNodeDialog(ServiceNode? node = null)
    {
        EditingNode = node;
        NodeForm = node is null ? new() : new NodeFormModel
        {
            Name = node.Name,
            Owner = node.Owner,
            Team = node.Team,
            Description = node.Description,
            Status = node.Status,
            Technology = node.Technology,
            Version = node.Version,
            SwaggerUrl = node.SwaggerUrl,
            WsdlUrl = node.WsdlUrl,
            HealthCheckUrl = node.HealthCheckUrl,
            ProjectIds = node.ProjectIds.ToList()
        };
        if (ActiveProject is not null && !NodeForm.ProjectIds.Contains(ActiveProject.Id))
            NodeForm.ProjectIds.Add(ActiveProject.Id);
        ShowNodeDialog = true;
        ShowProjectDropdown = false;
    }

    private void ToggleNodeProject(Guid projId, bool on)
    {
        if (on) { if (!NodeForm.ProjectIds.Contains(projId)) NodeForm.ProjectIds.Add(projId); }
        else NodeForm.ProjectIds.Remove(projId);
    }

    private void SaveNode()
    {
        if (string.IsNullOrWhiteSpace(NodeForm.Name)) return;
        if (TreeService.NodeNameExists(NodeForm.Name, EditingNode?.Id)) return;
        var rng = new Random();

        if (EditingNode is null)
        {
            TreeService.AddNode(new ServiceNode
            {
                Name = NodeForm.Name,
                Owner = NodeForm.Owner,
                Team = NodeForm.Team,
                Description = NodeForm.Description,
                Status = NodeForm.Status,
                Technology = NodeForm.Technology,
                Version = NodeForm.Version,
                SwaggerUrl = NodeForm.SwaggerUrl,
                WsdlUrl = NodeForm.WsdlUrl,
                HealthCheckUrl = NodeForm.HealthCheckUrl,
                ProjectIds = NodeForm.ProjectIds,
                PositionX = rng.Next(100, 800),
                PositionY = rng.Next(80, 450)
            });
        }
        else
        {
            EditingNode.Name = NodeForm.Name; EditingNode.Owner = NodeForm.Owner;
            EditingNode.Team = NodeForm.Team; EditingNode.Description = NodeForm.Description;
            EditingNode.Status = NodeForm.Status; EditingNode.Technology = NodeForm.Technology;
            EditingNode.Version = NodeForm.Version; EditingNode.SwaggerUrl = NodeForm.SwaggerUrl;
            EditingNode.WsdlUrl = NodeForm.WsdlUrl; EditingNode.HealthCheckUrl = NodeForm.HealthCheckUrl;
            EditingNode.ProjectIds = NodeForm.ProjectIds;
            TreeService.UpdateNode(EditingNode);
        }
        CloseDialogs();
    }

    // ── Delete node ──────────────────────────────────────────
    private void ConfirmDeleteNode(ServiceNode n) { NodeToDelete = n; ShowDeleteConfirm = true; }
    private void ExecuteDeleteNode()
    {
        if (NodeToDelete is not null)
        {
            if (SelectedNode?.Id == NodeToDelete.Id) SelectedNode = null;
            if (SelectedConnection is not null &&
                (SelectedConnection.SourceId == NodeToDelete.Id || SelectedConnection.TargetId == NodeToDelete.Id))
                SelectedConnection = null;
            TreeService.RemoveNode(NodeToDelete.Id);
            NodeToDelete = null;
            _ = UpdateMinimapAsync();
        }
        ShowDeleteConfirm = false;
    }

    // ── Connection dialog ─────────────────────────────────────
    private void OpenAddConnectionDialog(ServiceNode? preselect = null)
    {
        ConnForm = new ConnectionFormModel { SourceIdStr = preselect?.Id.ToString() ?? "" };
        ShowConnectionDialog = true;
    }

    private void SaveConnection()
    {
        if (!Guid.TryParse(ConnForm.SourceIdStr, out var src)) return;
        if (!Guid.TryParse(ConnForm.TargetIdStr, out var tgt)) return;
        if (src == tgt) return;
        if (!ConnectionCandidateNodes.Any(n => n.Id == src) || !ConnectionTargetCandidateNodes.Any(n => n.Id == tgt)) return;
        TreeService.AddConnection(new ServiceConnection
        {
            SourceId = src,
            TargetId = tgt,
            Label = ConnForm.Label,
            ConnectionType = ConnForm.ConnectionType
        });
        CloseDialogs();
    }

    private void DeleteConnection(Guid connectionId)
    {
        if (SelectedConnection?.Id == connectionId) SelectedConnection = null;
        TreeService.RemoveConnection(connectionId);
        _ = UpdateMinimapAsync();
    }

    private void DeleteSelectedConnection()
    {
        if (SelectedConnection is not null)
        {
            TreeService.RemoveConnection(SelectedConnection.Id);
            SelectedConnection = null;
            _ = UpdateMinimapAsync();
        }
    }

    // ── Project dialog ────────────────────────────────────────
    private void OpenProjectDialog(ServiceProject? proj = null)
    {
        EditingProject = proj;
        ProjForm = proj is null ? new() : new ProjectFormModel
        {
            Name = proj.Name,
            Description = proj.Description,
            Owner = proj.Owner,
            Color = proj.Color,
            Status = proj.Status
        };
        ShowProjectDialog = true;
    }

    private void SaveProject()
    {
        if (string.IsNullOrWhiteSpace(ProjForm.Name)) return;
        if (EditingProject is null)
        {
            TreeService.AddProject(new ServiceProject
            {
                Name = ProjForm.Name,
                Description = ProjForm.Description,
                Owner = ProjForm.Owner,
                Color = ProjForm.Color,
                Icon = "📁",   // fixed neutral default — no user input
                Status = ProjForm.Status
            });
        }
        else
        {
            EditingProject.Name = ProjForm.Name; EditingProject.Description = ProjForm.Description;
            EditingProject.Owner = ProjForm.Owner; EditingProject.Color = ProjForm.Color;
            // Icon intentionally not updated — fixed default
            EditingProject.Status = ProjForm.Status;
            TreeService.UpdateProject(EditingProject);
        }
        CloseDialogs();
    }

    private void CloseDialogs()
    {
        ShowNodeDialog = ShowConnectionDialog = ShowProjectDialog = false;
        ShowProjectDropdown = false;
        EditingNode = null; EditingProject = null;
    }

    // ── Delete project ────────────────────────────────────────
    private void DeleteProject(ServiceProject project)
    {
        if (ActiveProject?.Id == project.Id)
        {
            ActiveProject = null;
            ShowAllNodes = false;
            DeselectAll();
        }
        TreeService.RemoveProject(project.Id);
    }

    // ── Helpers ──────────────────────────────────────────────
    private static double Clamp(double value, double min, double max) => Math.Min(Math.Max(value, min), max);

    private static string GetStatusIcon(string status) => status switch
    {
        "Active" => "🟢",
        "Down" => "🔴",
        _ => "🔴"
    };

    private static (string color, string markerId) GetConnStyle(string type) => type switch
    {
        "REST" => ("#4f86c6", "arr-rest"),
        "SOAP" => ("#8e44ad", "arr-soap"),
        "MQ" => ("#e67e22", "arr-mq"),
        "gRPC" => ("#16a085", "arr-grpc"),
        "JAR" => ("#f1c40f", "arr-jar"),
        "Anasistem" => ("#c0392b", "arr-default"),
        "UI" => ("#f8fafc", "arr-ui"),
        _ => ("#7f8c8d", "arr-default")
    };

    // ── Form models ───────────────────────────────────────────
    private class NodeFormModel
    {
        public string Name { get; set; } = "";
        public string Owner { get; set; } = "";
        public string Team { get; set; } = "";
        public string Description { get; set; } = "";
        public string Status { get; set; } = "Active";
        public string Technology { get; set; } = "REST";
        public string Version { get; set; } = "";
        public string SwaggerUrl { get; set; } = "";
        public string WsdlUrl { get; set; } = "";
        public string HealthCheckUrl { get; set; } = "";
        public List<Guid> ProjectIds { get; set; } = new();
    }

    private class ConnectionFormModel
    {
        public string SourceIdStr { get; set; } = "";
        public string TargetIdStr { get; set; } = "";
        public string Label { get; set; } = "";
        public string ConnectionType { get; set; } = "REST";
    }

    private class ProjectFormModel
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Owner { get; set; } = "";
        public string Color { get; set; } = "#4f86c6";
        public string Status { get; set; } = "Active";
    }
}

