@page "/"
@using ServiceTreeDemo
@using ServiceTreeDemo.Models
@using ServiceTreeDemo.Services
@inject ServiceTreeService TreeService
@inject ServiceTreeDemo.Services.HealthCheckService HealthChecker
@inject IJSRuntime JS
@rendermode InteractiveServer
@implements IDisposable

<div class="st-shell" id="app-shell">

    <!-- ═══ TOP BAR ═══ -->
    <header class="st-topbar">
        <div class="st-topbar-left">
            <span class="st-logo">🌐</span>
            <span class="st-title">ServiceMap</span>
            @if (ShowAllNodes)
            {
                <button class="st-btn-home" title="Ana Sayfaya Dön" @onclick="GoHome">⌂ Ana Sayfa</button>
                <span class="st-breadcrumb-sep">›</span>
                <span class="st-subtitle">@(ActiveProject is not null ? ActiveProject.Name : "Tüm Servisler")</span>
            }
        </div>
        <div class="st-topbar-center">
            <div class="st-search-wrap">
                <span class="st-search-icon">🔍</span>
                <input class="st-search" placeholder="Servis veya proje ara..." @bind="SearchQuery" @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(SearchQuery))
                {
                    <button class="st-search-clear" @onclick="() => SearchQuery = string.Empty">✕</button>
                }
            </div>
        </div>
        <div class="st-topbar-right">
            <span class="st-badge blue">@VisibleNodes.Count servis</span>
            <span class="st-badge gray">@VisibleConnections.Count bağlantı</span>

            <!-- Zoom controls -->
            <div class="st-zoom-group">
                <button class="st-zoom-btn" title="Uzaklaştır" @onclick="ZoomOut">−</button>
                <button class="st-zoom-btn" title="Sıfırla" @onclick="ResetZoom">⊡</button>
                <button class="st-zoom-btn" title="Yakınlaştır" @onclick="ZoomIn">+</button>
            </div>

            <!-- Auto Layout -->
            <button class="st-btn-secondary" title="Otomatik Yerleşim" @onclick="RunAutoLayout">⚡ Düzenle</button>

            <!-- Export -->
            <button class="st-btn-secondary" title="SVG olarak kaydet" @onclick="ExportSVG">⬇ SVG</button>
            <button class="st-btn-secondary" title="PNG olarak kaydet" @onclick="ExportPNG">⬇ PNG</button>

            <!-- Dark mode toggle -->
            <button class="st-btn-theme" title="Tema değiştir" @onclick="ToggleTheme">@(IsDark ? "☀️" : "🌙")</button>

            <!-- Guide -->
            <button class="st-btn-secondary st-btn-guide" title="Nasıl kullanılır?" @onclick="() => ShowGuide = true">❓ Rehber</button>

            <!-- Health check -->
            <button class="st-btn-secondary @(CheckingHealth ? "loading" : "")" title="Servisleri kontrol et" @onclick="RunHealthCheck" disabled="@CheckingHealth">
                @(CheckingHealth ? "⟳ Kontrol..." : "📡 Kontrol")
            </button>

        </div>
    </header>

    <div class="st-body">

        <!-- ═══ LEFT: PROJECT TREE PANEL ═══ -->
        <aside class="st-sidebar">
            <div class="st-sidebar-section">
                <div class="st-sidebar-header">
                    <span>Projeler</span>
                    <button class="st-mini-btn" @onclick="() => OpenProjectDialog()">+</button>
                </div>

                <button class="st-project-btn @(ShowAllNodes && ActiveProject is null ? "active" : "")" @onclick="ShowAll">
                    <span>🗺️</span>
                    <div class="st-project-info">
                        <div class="st-project-name">Tüm Servisler</div>
                        <div class="st-project-meta">@TreeService.Nodes.Count servis</div>
                    </div>
                </button>

                @foreach (var project in FilteredProjects)
                {
                    var isActive = ActiveProject?.Id == project.Id;
                    var count = TreeService.GetNodesForProject(project.Id).Count;
                    <div class="st-project-item @(isActive ? "open" : "")">
                        <div class="st-project-btn-row">
                            <button class="st-project-btn @(isActive ? "active" : "")" @onclick="() => SelectProject(project)" style="flex:1;min-width:0">
                                <span class="st-project-color-dot" style="background:@project.Color"></span>
                                <div class="st-project-info">
                                    <div class="st-project-name">@project.Name</div>
                                    <div class="st-project-meta">@count servis · @project.Owner</div>
                                </div>
                                <div class="st-project-dot" style="background:@project.Color"></div>
                            </button>
                            <button class="st-project-delete-btn"
                                    title="Projeyi sil"
                                    @onclick:stopPropagation
                                    @onclick="() => DeleteProject(project)">
                                🗑
                            </button>
                        </div>

                        @if (isActive)
                        {
                            <div class="st-project-services">
                                @foreach (var node in TreeService.GetNodesForProject(project.Id))
                                {
                                    <button class="st-service-leaf @(SelectedNode?.Id == node.Id ? "selected" : "")"
                                            @onclick="() => SelectNode(node)">
                                        <span class="st-status-dot st-status-@node.Status.ToLower()"></span>
                                        <span class="st-leaf-name">@node.Name</span>
                                        <span class="st-leaf-tech">@node.Technology</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="st-sidebar-section">
                <div class="st-sidebar-header"><span>Filtrele</span></div>
                <div class="st-filter-group">
                    <div class="st-filter-label">Durum</div>
                    @foreach (var s in new[] { "Active", "Down" })
                    {
                        <label class="st-filter-check">
                            <input type="checkbox" checked="@StatusFilter.Contains(s)"
                                   @onchange="e => ToggleStatusFilter(s, (bool)e.Value!)" />
                            <span class="st-status-dot st-status-@s.ToLower()"></span> @s
                        </label>
                    }
                </div>
                <div class="st-filter-group">
                    <div class="st-filter-label">Teknoloji</div>
                    @foreach (var t in new[] { "REST", "SOAP", "JAR", "gRPC", "MQ", "Anasistem", "UI" })
                    {
                        <label class="st-filter-check">
                            <input type="checkbox" checked="@TechFilter.Contains(t)"
                                   @onchange="e => ToggleTechFilter(t, (bool)e.Value!)" />
                            <span class="st-tech-pill @t.ToLower()">@t</span>
                        </label>
                    }
                </div>
            </div>

            <!-- Minimap -->
            <div class="st-minimap-wrap">
                <div class="st-minimap-label">Genel Görünüm</div>
                <canvas id="minimap-canvas" class="st-minimap-canvas" width="200" height="110"></canvas>
            </div>
        </aside>

        <!-- ═══ CENTER: CANVAS ═══ -->
        <main class="st-canvas-wrap" id="canvas-wrap" style="position:relative">

            @if (ActiveProject is null && !ShowAllNodes)
            {
                <div class="st-welcome">
                    @if (!TreeService.Projects.Any())
                    {
                        <!-- Empty state — first time user -->
                        <div class="st-welcome-empty">
                            <div class="st-welcome-icon">🌐</div>
                            <h2>ServiceMap'e Hoş Geldiniz</h2>
                            <p class="st-welcome-sub">Kurumunuzdaki tüm dijital servisleri ve aralarındaki bağlantıları tek haritada yönetin.</p>
                            <div class="st-welcome-features">
                                <div class="st-feature-item"><span class="st-feature-icon">🗂️</span><span>Projeler oluşturun ve servisleri gruplandırın</span></div>
                                <div class="st-feature-item"><span class="st-feature-icon">🔗</span><span>Servisler arası bağımlılıkları haritalayın</span></div>
                                <div class="st-feature-item"><span class="st-feature-icon">📡</span><span>Health Check ile canlı durum izleyin</span></div>
                                <div class="st-feature-item"><span class="st-feature-icon">⬇️</span><span>SVG / PNG olarak dışa aktarın</span></div>
                            </div>
                            <div class="st-welcome-fabs">
                                <button class="st-fab st-fab-project" title="Yeni Proje Ekle" @onclick="() => OpenProjectDialog()">
                                    <span class="st-fab-icon">🗂️</span>
                                    <span class="st-fab-label">İlk Projeyi Oluştur</span>
                                </button>
                                <button class="st-btn-guide-inline" @onclick="() => ShowGuide = true">❓ Nasıl kullanılır?</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Has projects — show cards -->
                        <div class="st-welcome-icon">🌐</div>
                        <h2>ServiceMap</h2>
                        <p>Soldaki panelden bir proje seçin veya tüm servisleri görüntüleyin.</p>
                        <div class="st-project-cards">
                            @foreach (var p in TreeService.Projects)
                            {
                                <div class="st-project-card" style="border-color:@p.Color" @onclick="() => SelectProject(p)">
                                    <div class="st-project-card-icon" style="background:@p.Color">
                                        <span style="color:#fff;font-size:1.1rem;font-weight:700">@p.Name.Substring(0, Math.Min(2, p.Name.Length)).ToUpper()</span>
                                    </div>
                                    <div class="st-project-card-name">@p.Name</div>
                                    <div class="st-project-card-desc">@p.Description</div>
                                    <div class="st-project-card-footer">
                                        <span>@TreeService.GetNodesForProject(p.Id).Count servis</span>
                                        <span class="st-status-badge @p.Status.ToLower()">@p.Status</span>
                                    </div>
                                </div>
                            }
                        </div>
                        <!-- Welcome FABs -->
                        <div class="st-welcome-fabs">
                            <button class="st-fab st-fab-project" title="Yeni Proje Ekle" @onclick="() => OpenProjectDialog()">
                                <span class="st-fab-icon">🗂️</span>
                                <span class="st-fab-label">Yeni Proje</span>
                            </button>
                            <button class="st-fab st-fab-service" title="Yeni Servis Ekle" @onclick="() => OpenNodeDialog()">
                                <span class="st-fab-icon">⚙️</span>
                                <span class="st-fab-label">Yeni Servis</span>
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Zoom hint -->
                <div class="st-canvas-hints">
                    <span>🖱 Tekerlek: zoom &nbsp;·&nbsp; Alt+Sürükle: kaydır &nbsp;·&nbsp; Node sürükle: taşı</span>
                </div>

                <!-- SVG CANVAS -->
                <div class="st-canvas" id="st-canvas" @onclick="DeselectAll">
                    <div class="st-canvas-inner" id="st-canvas-inner">

                        <svg class="st-svg" id="st-svg" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <marker id="arr-rest" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
                                    <polygon points="0 0, 10 3.5, 0 7" fill="#4f86c6" />
                                </marker>
                                <marker id="arr-soap" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
                                    <polygon points="0 0, 10 3.5, 0 7" fill="#8e44ad" />
                                </marker>
                                <marker id="arr-mq" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
                                    <polygon points="0 0, 10 3.5, 0 7" fill="#e67e22" />
                                </marker>
                                <marker id="arr-default" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
                                    <polygon points="0 0, 10 3.5, 0 7" fill="#7f8c8d" />
                                </marker>
                                <marker id="arr-grpc" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
                                    <polygon points="0 0, 10 3.5, 0 7" fill="#16a085" />
                                </marker>
                                <marker id="arr-jar" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
                                    <polygon points="0 0, 10 3.5, 0 7" fill="#f1c40f" />
                                </marker>
                                <marker id="arr-ui" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
                                    <polygon points="0 0, 10 3.5, 0 7" fill="#f8fafc" stroke="#94a3b8" stroke-width="0.5" />
                                </marker>
                                <filter id="glow">
                                    <feGaussianBlur stdDeviation="3" result="coloredBlur" />
                                    <feMerge><feMergeNode in="coloredBlur" /><feMergeNode in="SourceGraphic" /></feMerge>
                                </filter>
                            </defs>

                            @foreach (var conn in VisibleConnections)
                            {
                                var src = TreeService.GetNode(conn.SourceId);
                                var tgt = TreeService.GetNode(conn.TargetId);
                                if (src is null || tgt is null) continue;

                                var isHighlighted = SelectedNode is not null &&
                                (conn.SourceId == SelectedNode.Id || conn.TargetId == SelectedNode.Id);
                                var isDimmed = SelectedNode is not null && !isHighlighted;

                                double cx1 = src.PositionX + NodeW / 2;
                                double cy1 = src.PositionY + NodeH / 2;
                                double cx2 = tgt.PositionX + NodeW / 2;
                                double cy2 = tgt.PositionY + NodeH / 2;

                                double dx = cx2 - cx1;
                                double dy = cy2 - cy1;
                                double len = Math.Sqrt(dx * dx + dy * dy);
                                if (len < 1) continue;

                                double ux = dx / len;
                                double uy = dy / len;

                                double trim = 68;
                                double x1e = cx1 + ux * trim;
                                double y1e = cy1 + uy * trim;
                                double x2e = cx2 - ux * trim;
                                double y2e = cy2 - uy * trim;

                                var sameConnections = VisibleConnections
                                .Where(c =>
                                (c.SourceId == conn.SourceId && c.TargetId == conn.TargetId) ||
                                (c.SourceId == conn.TargetId && c.TargetId == conn.SourceId))
                                .OrderBy(c => c.Id)
                                .ToList();

                                int total = sameConnections.Count;
                                int index = sameConnections.FindIndex(c => c.Id == conn.Id);

                                double spacing = 32;
                                double offset = (index - (total - 1) / 2.0) * spacing;

                                double midX = (x1e + x2e) / 2;
                                double midY = (y1e + y2e) / 2;

                                double baseCurve = total > 1 ? 10 : 30;

                                double cpx = midX - uy * (baseCurve + offset);
                                double cpy = midY + ux * (baseCurve + offset);

                                var (stroke, markerId) = GetConnStyle(conn.ConnectionType);
                                var strokeW = isHighlighted ? "2.8" : "1.8";
                                var opacity = isDimmed ? "0.18" : isHighlighted ? "1" : "0.75";

                                <path d="M @x1e.F() @y1e.F() Q @cpx.F() @cpy.F() @x2e.F() @y2e.F()"
                                      fill="none"
                                      stroke="@stroke"
                                      stroke-width="@strokeW"
                                      marker-end="url(#@markerId)"
                                      opacity="@opacity"
                                      filter="@(isHighlighted ? "url(#glow)" : "none")" />
                            }

                            <!-- Invisible click targets for connections -->
                            @foreach (var conn in VisibleConnections)
                            {
                                var src = TreeService.GetNode(conn.SourceId);
                                var tgt = TreeService.GetNode(conn.TargetId);
                                if (src is null || tgt is null) continue;
                                double cx1 = src.PositionX + NodeW / 2, cy1 = src.PositionY + NodeH / 2;
                                double cx2 = tgt.PositionX + NodeW / 2, cy2 = tgt.PositionY + NodeH / 2;
                                double mx = (cx1 + cx2) / 2, my = (cy1 + cy2) / 2;
                                <circle cx="@mx.F()" cy="@my.F()" r="10" fill="transparent"
                                        @onclick:stopPropagation
                                        @onclick="() => SelectConnection(conn)"
                                        style="cursor:pointer" />
                            }
                        </svg>

                        <!-- Node Cards -->
                        @foreach (var node in VisibleNodes)
                        {
                            var isSelected = SelectedNode?.Id == node.Id;
                            var isRelated = SelectedNode is not null && IsRelated(node);
                            var isDimmed = SelectedNode is not null && !isSelected && !isRelated;
                            var nodeProjects = node.ProjectIds.Select(pid => TreeService.GetProject(pid)).Where(p => p is not null).ToList();
                            var nodeIdStr = node.Id.ToString();

                            <div class="st-node @node.Status.ToLower() @(isSelected ? "selected" : "") @(isDimmed ? "dimmed" : "") @(isRelated ? "related" : "")"
                                 id="node-@nodeIdStr"
                                 style="left:@(node.PositionX)px; top:@(node.PositionY)px; width:@(NodeW)px;"
                                 @onclick:stopPropagation
                                 @onclick="() => SelectNode(node)">

                                <div class="st-node-header">
                                    <span class="st-node-tech @node.Technology.ToLower()">@node.Technology</span>
                                    <span class="st-node-status @node.Status.ToLower()">@GetStatusIcon(node.Status)</span>
                                </div>
                                <div class="st-node-name">@node.Name</div>
                                <div class="st-node-team">@node.Team</div>

                                @if (!string.IsNullOrEmpty(node.HealthCheckUrl))
                                {
                                    <div class="st-node-health-time">
                                        @(node.LastHealthCheck.HasValue ? "🕐 " + node.LastHealthCheck.Value.ToString("HH:mm") : "📡 kontrol bekleniyor")
                                    </div>
                                }

                                @if (nodeProjects.Any())
                                {
                                    <div class="st-node-projects">
                                        @foreach (var proj in nodeProjects.Take(2))
                                        {
                                            <span class="st-node-project-dot" style="background:@proj!.Color" title="@proj!.Name"></span>
                                        }
                                        @if (nodeProjects.Count > 2)
                                        {
                                            <span class="st-node-project-more">+@(nodeProjects.Count - 2)</span>
                                        }
                                    </div>
                                }

                                @if (isSelected)
                                {
                                    <div class="st-node-actions">
                                        <button class="st-node-btn" @onclick:stopPropagation @onclick="() => OpenNodeDialog(node)" title="Düzenle">✏️</button>
                                        <button class="st-node-btn" @onclick:stopPropagation @onclick="() => OpenAddConnectionDialog(node)" title="Bağlantı ekle">🔗</button>
                                        <button class="st-node-btn danger" @onclick:stopPropagation @onclick="() => ConfirmDeleteNode(node)" title="Sil">🗑️</button>
                                    </div>
                                }
                            </div>
                        }

                        @* ── Cross-project ghost nodes ── *@
                        @* Seçili node varsa, farklı projedeki upstream/downstream servisler ghost olarak gösterilir *@
                        @if (SelectedNode is not null)
                        {
                            foreach (var (ghostNode, ghostConn, isUp) in TreeService.GetCrossProjectNeighbours(SelectedNode.Id))
                            {
                                var ghostProjects = ghostNode.ProjectIds
                                .Select(pid => TreeService.GetProject(pid))
                                .Where(p => p is not null).ToList();
                                var firstProjectColor = ghostProjects.FirstOrDefault()?.Color ?? "#999";

                                // Gerçek pozisyonu kullan; canvas sınırına kısıtle
                                var ghostX = Math.Max(10, ghostNode.PositionX);
                                var ghostY = Math.Max(10, ghostNode.PositionY);

                                <div class="st-node ghost @ghostNode.Status.ToLower()"
                                     style="left:@(ghostX)px; top:@(ghostY)px; width:@(NodeW)px; border-color:@firstProjectColor;"
                                     title="Farklı projeden: @string.Join(", ", ghostProjects.Select(p => p!.Name))">

                                    <div class="st-node-header">
                                        <span class="st-node-tech @ghostNode.Technology.ToLower()">@ghostNode.Technology</span>
                                        <span class="st-node-status @ghostNode.Status.ToLower()">@GetStatusIcon(ghostNode.Status)</span>
                                    </div>
                                    <div class="st-node-name">@ghostNode.Name</div>
                                    <div class="st-node-team">@ghostNode.Team</div>

                                    <div class="st-node-projects" style="margin-top:4px">
                                        @foreach (var proj in ghostProjects.Take(2))
                                        {
                                            <span class="st-node-project-dot" style="background:@proj!.Color" title="@proj!.Name"></span>
                                        }
                                        <span class="st-cross-project-badge">↗ @(isUp ? "upstream" : "downstream")</span>
                                    </div>
                                </div>
                            }
                        }

                    </div><!-- /canvas-inner -->
                </div>

                <!-- Legend -->
                <div class="st-legend">
                    <span class="st-legend-item">
                        <span style="background:#4f86c6;width:12px;height:3px;display:inline-block"></span> REST
                    </span>
                    <span class="st-legend-item">
                        <span style="background:#8e44ad;width:12px;height:3px;display:inline-block"></span> SOAP
                    </span>
                    <span class="st-legend-item">
                        <span style="background:#e67e22;width:12px;height:3px;display:inline-block"></span> MQ
                    </span>
                    <span class="st-legend-item">
                        <span style="background:#16a085;width:12px;height:3px;display:inline-block"></span> gRPC
                    </span>
                    <span class="st-legend-item">
                        <span style="background:#f1c40f;width:12px;height:3px;display:inline-block"></span> JAR
                    </span>
                    <span class="st-legend-item">
                        <span style="background:#c0392b;width:12px;height:3px;display:inline-block"></span> Anasistem
                    </span>
                    <span class="st-legend-item">
                        <span style="background:#f8fafc;border:1px solid #94a3b8;width:12px;height:3px;display:inline-block"></span> UI
                    </span>
                </div>

                <!-- Canvas FABs — bottom-left, outside pan/zoom so they never scroll -->
                <div class="st-canvas-fabs" @onclick:stopPropagation>
                    <button class="st-fab st-fab-service" title="Yeni Servis Ekle" @onclick="() => OpenNodeDialog()">
                        <span class="st-fab-icon">⚙️</span>
                        <span class="st-fab-label">Yeni Servis</span>
                    </button>
                    <button class="st-fab st-fab-project" title="Yeni Proje Ekle" @onclick="() => OpenProjectDialog()">
                        <span class="st-fab-icon">🗂️</span>
                        <span class="st-fab-label">Yeni Proje</span>
                    </button>
                </div>
            }
        </main>

        <!-- ═══ RIGHT: DETAIL PANEL ═══ -->
        <aside class="st-detail @(SelectedNode is not null || SelectedConnection is not null ? "visible" : "")">

            @if (SelectedNode is not null)
            {
                var upstreams = TreeService.GetUpstream(SelectedNode.Id);
                var downstreams = TreeService.GetDownstream(SelectedNode.Id);
                var nodeProjects = SelectedNode.ProjectIds
                .Select(pid => TreeService.GetProject(pid))
                .Where(p => p is not null).ToList();

                <div class="st-detail-header">
                    <div class="st-detail-status @SelectedNode.Status.ToLower()">@GetStatusIcon(SelectedNode.Status) @SelectedNode.Status</div>
                    <button class="st-detail-close" @onclick="DeselectAll">✕</button>
                </div>

                <div class="st-detail-title">@SelectedNode.Name</div>
                <div class="st-detail-sub">v@SelectedNode.Version · @SelectedNode.Team</div>

                <div class="st-detail-desc">@SelectedNode.Description</div>

                <div class="st-detail-row">
                    <span class="st-detail-label">Sahip</span>
                    <span class="st-detail-val">@SelectedNode.Owner</span>
                </div>
                <div class="st-detail-row">
                    <span class="st-detail-label">Teknoloji</span>
                    <span class="st-tech-pill @SelectedNode.Technology.ToLower()">@SelectedNode.Technology</span>
                </div>

                @if (SelectedNode.LastHealthCheck.HasValue)
                {
                    <div class="st-detail-row">
                        <span class="st-detail-label">Son kontrol</span>
                        <span class="st-detail-val">@SelectedNode.LastHealthCheck.Value.ToString("HH:mm:ss")</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(SelectedNode.SwaggerUrl))
                {
                    <div class="st-detail-row">
                        <span class="st-detail-label">Swagger</span>
                        <a href="@SelectedNode.SwaggerUrl" target="_blank" class="st-link">🔗 Swagger UI</a>
                    </div>
                }
                @if (!string.IsNullOrEmpty(SelectedNode.WsdlUrl))
                {
                    <div class="st-detail-row">
                        <span class="st-detail-label">WSDL</span>
                        <a href="@SelectedNode.WsdlUrl" target="_blank" class="st-link">🔗 WSDL</a>
