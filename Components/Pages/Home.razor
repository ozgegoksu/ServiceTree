                            }
                            @if (downConn is not null)
                            {
                                <button class="st-inline-delete" title="Bağlantıyı sil" @onclick:stopPropagation @onclick="() => DeleteConnection(downConn.Id)">🗑</button>
                            }
                            @if (isCrossDown)
