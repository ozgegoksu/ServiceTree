                                <span class="st-dep-cross-badge" title="Farklı projeden">↗</span>
                            }
                        </div>
                    }
                }

                <div class="st-detail-actions">
                    <button class="st-action-btn primary" @onclick="() => OpenNodeDialog(SelectedNode)">✏️ Düzenle</button>
                    <button class="st-action-btn" @onclick="() => OpenAddConnectionDialog(SelectedNode)">🔗 Bağlantı Ekle</button>
                    <button class="st-action-btn danger" @onclick="() => ConfirmDeleteNode(SelectedNode)">🗑️ Sil</button>
                </div>
            }

            @if (SelectedConnection is not null)
            {
                var src = TreeService.GetNode(SelectedConnection.SourceId);
                var tgt = TreeService.GetNode(SelectedConnection.TargetId);
                var (stroke, _) = GetConnStyle(SelectedConnection.ConnectionType);

                <div class="st-detail-header">
                    <div class="st-detail-status" style="background:#f0f4ff;color:#4f86c6">🔗 Bağlantı</div>
                    <button class="st-detail-close" @onclick="DeselectAll">✕</button>
                </div>

                <div class="st-detail-title">@SelectedConnection.Label</div>
                <div class="st-detail-sub" style="color:@stroke">@SelectedConnection.ConnectionType</div>

                <div class="st-detail-row">
                    <span class="st-detail-label">Kaynak</span>
                    <span class="st-detail-val">@src?.Name</span>
                </div>
                <div class="st-detail-row">
                    <span class="st-detail-label">Hedef</span>
                    <span class="st-detail-val">@tgt?.Name</span>
                </div>
                <div class="st-detail-actions">
                    <button class="st-action-btn danger" @onclick="DeleteSelectedConnection">🗑️ Bağlantıyı Sil</button>
                </div>
            }
        </aside>

    </div>
